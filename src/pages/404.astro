---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

Astro.response.status = 404;
---

<Layout title="Not found — DRPZNE">
  <Header />
  <main class="nf-main">
    <p class="nf-code font-oxanium">404</p>
    <h1 class="nf-title font-oxanium">This drop doesn't exist</h1>
    <p class="nf-text">It may have sold out, moved, or never existed in the first place.</p>
    <a href="/" class="nf-btn font-oxanium">Back to the latest drops</a>
  </main>
  <Footer />
</Layout>

<style>
  .nf-main {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1rem;
    gap: 0.75rem;
  }
  .nf-code { font-size: 4rem; font-weight: 800; color: var(--accent); margin: 0; line-height: 1; }
  .nf-title { font-size: clamp(1.25rem, 4vw, 2rem); margin: 0; text-transform: uppercase; letter-spacing: 0.06em; }
  .nf-text { color: var(--text-muted); margin: 0 0 1rem; }
  .nf-btn {
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 0.75rem 1.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .nf-btn:hover { background: var(--text); color: var(--bg); }
</style>
