---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={`${title} — DRPZNE`} description={description}>
  <Header />
  <main class="info-main">
    <h1 class="info-title font-oxanium">{title}</h1>
    <div class="info-body">
      <slot />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .info-main {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    min-height: 70vh;
  }
  .info-title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 2rem;
  }
  .info-body :global(p),
  .info-body :global(li) {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .info-body :global(h2) {
    font-family: 'Oxanium', sans-serif;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 2rem 0 0.5rem;
  }
  .info-body :global(ul) { list-style: disc; padding-left: 1.25rem; }
  .info-body :global(a) { color: var(--accent); }
  .info-body :global(a:hover) { color: var(--accent-hover); }
  @media (max-width: 640px) {
    .info-main { padding: 2rem 1rem 4rem; }
  }
</style>
