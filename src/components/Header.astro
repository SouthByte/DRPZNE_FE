<script>

  //On load for the header
  document.addEventListener('DOMContentLoaded', () => {
    const icon = document.getElementById('searchIcon');
    const nav  = document.querySelector('.navItem') as HTMLElement;
    const input = document.querySelector('#searchInput') as HTMLElement;
    const classLink = document.querySelector('.navLink') as HTMLElement;

    icon?.addEventListener('click', (e) => {
      e.preventDefault();
        nav.style.display = 'none';
        input.style.marginRight = '2rem';
      //nav?.classList.remove('visible');
      input?.classList.remove('hidden');
      input?.focus();
    });

    input?.addEventListener('focusout', (e) => {
      if(searchCardContainer.style.height == "0px"){
        e.preventDefault();
        nav.style.display = 'flex';
        input?.classList.add('hidden');
      }
    });

    input.addEventListener('input', (event) => {
      const target = event.target as HTMLInputElement;
      loadPosts(target.value);
    });
    const searchCardContainer = document.querySelector('.navbarSearchResults') as HTMLElement;
    const resultsBox = document.querySelector('.navbarSearchResults') as HTMLElement;
    document.addEventListener('mousedown', (event) => {
      if(searchCardContainer.style.height > "0px"){
      const clickedInsideInput = input.contains(event.target as Node);
      const clickedInsideResults = resultsBox.contains(event.target as Node);
      if (!clickedInsideInput && !clickedInsideResults) {
        resultsBox.animate(
        [
          { height: "200px" },
          { height: "0px" }
        ],
        {
            duration: 300,
            easing: "ease-in-out",
          }
        );
        resultsBox.style.height = '0';
        resultsBox.style.padding = '0';
        resultsBox.style.borderBottom = '0';
        resultsBox.innerHTML = '';

        nav.style.display = 'flex';
        input?.classList.add('hidden');
      }
      }

    });
  });

  const searchCardContainer = document.querySelector('.navbarSearchResults') as HTMLElement;
  function getMaxCardCount(): number {
    if (!searchCardContainer) return 0;

    const containerWidth = searchCardContainer.clientWidth;

    const cardWidth = 300; // px (adjust to your actual)
    const maxCards = Math.floor(containerWidth / cardWidth);
    console.log("macxed card count", maxCards);
    return maxCards;
  }

  async function loadPosts(searchString: string): Promise<any> {
    try{
      const searchCardContainer = document.querySelector('.navbarSearchResults') as HTMLElement;
      const searchTerms: string[] = searchString.toLowerCase().split(/\s+/).filter(Boolean);
      const res = await fetch('src/data/searchResultData.json');
      var innerHTMLCards = "";

      if(searchCardContainer.style.height == "0px"){
        searchCardContainer.animate(
        [
          { height: "0px" },
          { height: "200px" }
        ],
        {
            duration: 300,
            easing: "ease-in-out",
          }
        );
        searchCardContainer.style.height = '200px';
        searchCardContainer.style.padding = '12px';
        searchCardContainer.style.borderBottom = '1px solid white'
        searchCardContainer.focus();
      }

      if (!res.ok) {
        throw new Error(`HTTP error! status: ${res.status}`);
      }
      const data = (await res.json());
      // if no search terms, return all

      if (searchTerms.length === 0) {
        return data;
      }
      console.log(data, searchTerms);
      // filter: every term must exist in title OR description
      const filtered = data.filter((p: any) =>
        searchTerms.every((term) =>
          p.title.toLowerCase().includes(term)                        
        )
      );

      const filteredLength = filtered.length;

      filtered.slice(0, getMaxCardCount()).map((element: any) => {
        innerHTMLCards += `
          <div class="searchCard bg-cardBackground rounded-lg shadow-lg border-white border-1 h-full w-72 overflow-hidden transition-transform duration-200 hover:scale-105 cursor-pointer">
            <div class="h-2/3">
              <img src="${element.imageLink}" class="w-full h-full object-cover" />
            </div>
            <div class="h-1/3 flex justify-center items-center">
              <div>${element.title}</div>
            </div>
          </div>
        `;
      });

      if(filteredLength > getMaxCardCount()){
        innerHTMLCards += `
        <div class="h-full content-center items-center w-72 flex justify-center align-middle white text-4xl">
          View All
        </div>`
      }

      searchCardContainer.innerHTML = (innerHTMLCards)

    }
    catch(err){
      console.error('Error loading posts', err);
      return [];
    }
  }

</script>


