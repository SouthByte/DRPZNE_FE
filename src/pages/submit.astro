---
import InfoPage from '../components/InfoPage.astro';
import ContactLine from '../components/ContactLine.astro';
---

<InfoPage title="Submit a Drop" description="Tell DRPZNE about a new product drop.">
  <p>Launching something, or spotted a drop we should cover? Send us:</p>
  <ul>
    <li>The product name and brand</li>
    <li>A link to the product page</li>
    <li>The release date and price</li>
    <li>A few good photos</li>
  </ul>
  <ContactLine subject="Drop submission" />
</InfoPage>
