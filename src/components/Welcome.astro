---
import { getPostsSafe as getPosts, getPostsSafe } from '../lib/api';
import type { Post } from '../lib/api';

const posts: Post[] = await getPostsSafe({ page: 1, limit: 12 });

---

<section class="catalog-section">

  <!-- Category filter pills -->
  <div class="filter-bar" id="filterBar">
    <button class="filter-pill active" data-cat="all">All</button>
    <button class="filter-pill" data-cat="tactical">Tactical</button>
    <button class="filter-pill" data-cat="style">Style</button>
    <button class="filter-pill" data-cat="tech">Tech</button>
    <button class="filter-pill" data-cat="vehicles">Vehicles</button>
    <button class="filter-pill" data-cat="outdoors">Outdoors</button>
    <button class="filter-pill" data-cat="fitness">Fitness</button>
    <button class="filter-pill" data-cat="home">Home</button>
    <button class="filter-pill" data-cat="vices">Vices</button>
    <button class="filter-pill" data-cat="drops">Drops</button>
  </div>

  <!-- Grid -->
  <div class="posts-grid" id="postsGrid">
    {posts.map((post) => (
      <a href={`/${post.slug}`} class="post-card" data-cats={post.categories.join(',').toLowerCase()}>
        <div class="card-image">
          <img src={post.image} alt={post.title} loading="lazy" />
          <div class="card-cats">
            {post.categories.slice(0, 2).map((cat) => (
              <span class="card-cat-badge">{cat}</span>
            ))}
          </div>
        </div>
        <div class="card-body">
          <h3 class="card-title font-oxanium">{post.title}</h3>
          <p class="card-desc">{post.description}</p>
          <div class="card-footer">
            <span class="card-date">{new Date(post.publishedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            <span class="card-cta">Read More →</span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <!-- Load more -->
  <div class="load-more-wrap">
    <button class="load-more-btn font-oxanium" id="loadMoreBtn">
      <span id="loadMoreText">Load More</span>
      <span class="load-spinner hidden" id="loadSpinner">Loading...</span>
    </button>
  </div>
</section>

<script>
import { nullable } from "astro:schema";

  // ── Filter pills ──────────────────────────────────────────────────
  const pills = document.querySelectorAll('.filter-pill');
  const grid = document.getElementById('postsGrid');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');

      const cat = (pill as HTMLElement).dataset.cat;
      const cards = grid?.querySelectorAll('.post-card');

      cards?.forEach((card) => {
        const el = card as HTMLElement;
        if (cat === 'all') {
          el.style.display = '';
        } else {
          const cats = (el.dataset.cats || '').toLowerCase();
          el.style.display = cats?.includes(cat || "") ? '' : 'none';
        }
      });
    });
  });

  // ── Load more ─────────────────────────────────────────────────────
  let page = 1;
const loadBtn = document.getElementById('loadMoreBtn') as HTMLButtonElement;
const loadText = document.getElementById('loadMoreText')!;
const loadSpinner = document.getElementById('loadSpinner')!;

loadBtn?.addEventListener('click', async () => {
  page++;
  loadText?.classList.add('hidden');
  loadSpinner?.classList.remove('hidden');
  loadBtn.disabled = true;
    try {
      const cmsUrl = document.documentElement.dataset.cmsUrl || 'http://localhost:3000';
      const q = new URLSearchParams({
        'where[status][equals]': 'published',
        depth: '2',
        sort: '-publishedAt',
        limit: '12',
        page: String(page),
      });
      const res = await fetch(`${cmsUrl}/api/posts?${q}`);
      const data = await res.json();
      const posts = data.docs ?? [];

      if (!posts || posts.length === 0) {
        loadBtn.style.display = 'none';
        return;
      }

      posts.forEach((post: any) => {
        const card = document.createElement('a');
        card.href = `/${post.slug}`;
        card.className = 'post-card';
        card.dataset.cats = (post.categories || []).join(',').toLowerCase();
        card.innerHTML = `
          <div class="card-image">
            <img src="${post.image}" alt="${post.title}" loading="lazy" />
            <div class="card-cats">
              ${(post.categories || []).slice(0,2).map((c: string) => `<span class="card-cat-badge">${c}</span>`).join('')}
            </div>
          </div>
          <div class="card-body">
            <h3 class="card-title font-oxanium">${post.title}</h3>
            <p class="card-desc">${post.description}</p>
            <div class="card-footer">
              <span class="card-date">${new Date(post.publishedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span>
              <span class="card-cta">Read More →</span>
            </div>
          </div>`;
        grid?.appendChild(card);
      });

    } catch (err) {
      console.error('Load more failed:', err);
    } finally {
      loadText.classList.remove('hidden');
      loadSpinner.classList.add('hidden');
      loadBtn.removeAttribute('disabled');
    }
  });
</script>

<style>
  .catalog-section {
    background: var(--bg);
    min-height: calc(100vh - var(--nav-height));
    padding: 2rem 1.5rem 4rem;
  }

  /* ── Filter bar ── */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 2.5rem;
    padding: 0 0.5rem;
  }

  .filter-pill {
    font-family: 'Oxanium', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 0.35rem 0.9rem;
    transition: all 0.2s;
  }
  .filter-pill:hover { color: var(--text); border-color: var(--border-strong); }
  .filter-pill.active {
    color: var(--bg);
    background: var(--text);
    border-color: var(--text);
  }

  /* ── Grid ── */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── Card ── */
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
    cursor: pointer;
  }
  .post-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }

  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--bg-elevated);
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .post-card:hover .card-image img { transform: scale(1.04); }

  .card-cats {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .card-cat-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(0,0,0,0.7);
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 0.15rem 0.4rem;
    backdrop-filter: blur(4px);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem 1.1rem 1.1rem;
    gap: 0.5rem;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
    margin: 0;
  }

  .card-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .card-date {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .card-cta {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.04em;
    transition: color 0.15s;
  }
  .post-card:hover .card-cta { color: var(--accent-hover); }

  /* ── Load more ── */
  .load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .load-more-btn {
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--text);
    padding: 0.75rem 2.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background 0.2s, color 0.2s;
  }
  .load-more-btn:hover {
    background: var(--text);
    color: var(--bg);
  }
  .load-more-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .hidden { display: none !important; }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .catalog-section { padding: 1.5rem 1rem 3rem; }
    .posts-grid { grid-template-columns: 1fr; gap: 1.2rem; }
    .filter-bar { gap: 0.4rem; }
  }
</style>
