---
import '../styles/global.css';

const categories: Record<string, string[]> = {
  TACTICAL: ['Weapons', 'Hardware', 'Kit', 'Apparel', 'Accessories'],
  TECHNOLOGY: ['Comms', 'Power', 'Optics', 'Drones', 'Smart Home'],
  VEHICLES: ['Trucks', 'Cars', 'Motorcycles', 'Off-Road', 'Mods & Parts'],
  FITNESS: ['Supplements', 'Workout Gear', 'Recovery', 'Martial Arts'],
  OUTDOORS: ['Camping', 'Hunting', 'Fishing', 'Survival', 'Overlanding'],
  HOME: ['Kitchen Gear', 'Workspace', 'Workshop', 'Furniture'],
  VICES: ['Whiskey', 'Cigars', 'Beer', 'Cannabis'],
  DROPS: ['New Drops', 'Limited Editions', 'Collabs', 'Flash Sales'],
};
---

<header class="site-header" id="siteHeader">
  <!-- Logo -->
  <a href="/" class="header-logo font-oxanium" aria-label="DRPZNE Home">
    <img src="/src/assets/drpznewhitenobg.png" alt="DRPZNE" class="logo-img" />
  </a>

  <!-- Desktop Nav -->
  <nav class="desktop-nav" aria-label="Main navigation">
    {Object.keys(categories).map((cat) => (
      <button class="nav-btn" data-cat={cat} aria-expanded="false" aria-haspopup="true">
        {cat}
      </button>
    ))}
  </nav>

  <!-- Right side -->
  <div class="header-actions">
    <!-- Search -->
    <div class="search-wrapper" id="searchWrapper">
      <button class="icon-btn" id="searchToggle" aria-label="Search">
        <span class="material-icons">search</span>
      </button>
      <input
        type="text"
        class="search-input"
        id="searchInput"
        placeholder="Search drops..."
        autocomplete="off"
        aria-label="Search"
      />
    </div>

    <!-- Mobile hamburger -->
    <button class="icon-btn hamburger" id="mobileMenuToggle" aria-label="Open menu" aria-expanded="false">
      <span class="material-icons">menu</span>
    </button>
  </div>

  <!-- Mega dropdown (desktop) -->
  <div class="mega-dropdown" id="megaDropdown" aria-hidden="true" role="menu">
    <ul class="dropdown-list" id="dropdownList"></ul>
  </div>
</header>

<!-- Search results bar -->
<div class="search-results-bar" id="searchResultsBar" aria-live="polite"></div>

<!-- Mobile drawer -->
<div class="mobile-overlay" id="mobileOverlay"></div>
<nav class="mobile-drawer" id="mobileDrawer" aria-label="Mobile navigation">
  <div class="drawer-header">
    <img src="/src/assets/drpznewhitenobg.png" alt="DRPZNE" style="height:32px;" />
    <button class="icon-btn" id="drawerClose" aria-label="Close menu">
      <span class="material-icons">close</span>
    </button>
  </div>

  <!-- Search in mobile -->
  <div style="padding: 0 1rem 1rem;">
    <input
      type="text"
      class="mobile-search"
      id="mobileSearchInput"
      placeholder="Search drops..."
    />
  </div>

  <div class="drawer-categories">
    {Object.entries(categories).map(([cat, subs]) => (
      <details class="drawer-item">
        <summary class="drawer-cat font-oxanium">{cat}</summary>
        <ul class="drawer-subs">
          {subs.map((sub) => (
            <li><a href={`/category/${cat.toLowerCase()}/${sub.toLowerCase().replace(/[\s&/]+/g, '-')}`}>{sub}</a></li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</nav>

<script define:vars={{ categories }}>
  // ── Desktop dropdown ──────────────────────────────────────────────
  const header = document.getElementById('siteHeader');
  const dropdown = document.getElementById('megaDropdown');
  const list = document.getElementById('dropdownList');
  const navBtns = document.querySelectorAll('.nav-btn');
  let activeBtn = null;
  let closeTimer = null;

  function openDropdown(btn) {
    clearTimeout(closeTimer);
    const cat = btn.dataset.cat;
    const items = categories[cat] || [];

    list.innerHTML = items
      .map(
        (label) =>
          `<li><a href="/category/${cat.toLowerCase()}/${label.toLowerCase().replace(/[\s&/]+/g, '-')}" role="menuitem">${label}</a></li>`
      )
      .join('');

    navBtns.forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');
    btn.setAttribute('aria-expanded', 'true');
    dropdown.classList.add('open');
    dropdown.setAttribute('aria-hidden', 'false');
    activeBtn = btn;
  }

  function closeDropdown() {
    closeTimer = setTimeout(() => {
      dropdown.classList.remove('open');
      dropdown.setAttribute('aria-hidden', 'true');
      if (activeBtn) {
        activeBtn.classList.remove('active');
        activeBtn.setAttribute('aria-expanded', 'false');
        activeBtn = null;
      }
    }, 120);
  }

  navBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (activeBtn === btn && dropdown.classList.contains('open')) {
        closeDropdown();
      } else {
        openDropdown(btn);
      }
    });
  });

  dropdown.addEventListener('mouseenter', () => clearTimeout(closeTimer));
  dropdown.addEventListener('mouseleave', closeDropdown);

  document.addEventListener('click', (e) => {
    if (!header.contains(e.target) && !dropdown.contains(e.target)) {
      closeDropdown();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDropdown();
  });

  // ── Search ────────────────────────────────────────────────────────
  const searchToggle = document.getElementById('searchToggle');
  const searchInput = document.getElementById('searchInput');
  const searchWrapper = document.getElementById('searchWrapper');
  const resultsBar = document.getElementById('searchResultsBar');

  searchToggle.addEventListener('click', () => {
    searchWrapper.classList.toggle('open');
    if (searchWrapper.classList.contains('open')) {
      searchInput.focus();
    } else {
      searchInput.value = '';
      closeResultsBar();
    }
  });

  searchInput.addEventListener('focusout', (e) => {
    if (!resultsBar.contains(e.relatedTarget)) {
      setTimeout(() => {
        if (!resultsBar.matches(':hover')) closeResultsBar();
      }, 200);
    }
  });

  let searchDebounce;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => doSearch(searchInput.value), 220);
  });

  async function doSearch(q) {
    if (!q.trim()) return closeResultsBar();

    try {
      const apiBase = window.__DRPZNE_API__ || '';
      let posts = [];

      if (apiBase) {
        const res = await fetch(`${apiBase}/posts/search?q=${encodeURIComponent(q)}`);
        posts = await res.json();
      } else {
        const res = await fetch('/src/data/postData.json');
        const all = await res.json();
        posts = all.filter((p) =>
          p.title.toLowerCase().includes(q.toLowerCase()) ||
          (p.tags || []).some((t) => t.toLowerCase().includes(q.toLowerCase()))
        );
      }

      renderResults(posts.slice(0, 6));
    } catch {
      closeResultsBar();
    }
  }

  function renderResults(posts) {
    if (!posts.length) {
      resultsBar.innerHTML = `<div class="no-results">No results for that search</div>`;
      resultsBar.classList.add('open');
      return;
    }

    resultsBar.innerHTML = posts
      .map(
        (p) => `
      <a href="/${p.slug}" class="search-card">
        <div class="search-card-img">
          <img src="${p.image}" alt="${p.title}" loading="lazy" />
        </div>
        <div class="search-card-info">
          <div class="search-card-cat">${(p.categories || []).join(' / ')}</div>
          <div class="search-card-title">${p.title}</div>
        </div>
      </a>`
      )
      .join('');

    resultsBar.classList.add('open');
  }

  function closeResultsBar() {
    resultsBar.classList.remove('open');
    resultsBar.innerHTML = '';
  }

  document.addEventListener('mousedown', (e) => {
    if (!searchWrapper.contains(e.target) && !resultsBar.contains(e.target)) {
      closeResultsBar();
    }
  });

  // ── Mobile drawer ─────────────────────────────────────────────────
  const toggle = document.getElementById('mobileMenuToggle');
  const drawer = document.getElementById('mobileDrawer');
  const overlay = document.getElementById('mobileOverlay');
  const drawerClose = document.getElementById('drawerClose');

  function openDrawer() {
    drawer.classList.add('open');
    overlay.classList.add('open');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawerFn() {
    drawer.classList.remove('open');
    overlay.classList.remove('open');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle.addEventListener('click', openDrawer);
  drawerClose.addEventListener('click', closeDrawerFn);
  overlay.addEventListener('click', closeDrawerFn);

  // Mobile search mirrors desktop
  const mobileSearch = document.getElementById('mobileSearchInput');
  mobileSearch.addEventListener('input', () => {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => doSearch(mobileSearch.value), 220);
  });
</script>

<style>
  /* ── Header shell ── */
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--nav-height);
    z-index: 900;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0 1.5rem;
  }

  .logo-img {
    height: 70px;
    width: auto;
    filter: grayscale(1) brightness(2);
    transition: filter 0.2s;
  }
  .logo-img:hover { filter: none; }

  /* ── Desktop nav ── */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-btn {
    font-family: 'Oxanium', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--text-muted);
    padding: 0.4rem 0.6rem;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
  }
  .nav-btn:hover,
  .nav-btn.active {
    color: var(--text);
    background: var(--bg-elevated);
  }

  /* ── Header right ── */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .icon-btn {
    color: var(--text-muted);
    padding: 0.4rem;
    border-radius: 50%;
    transition: color 0.15s, background 0.15s;
    display: flex;
    align-items: center;
  }
  .icon-btn:hover { color: var(--text); background: var(--bg-elevated); }

  /* ── Search ── */
  .search-wrapper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search-input {
    width: 0;
    opacity: 0;
    pointer-events: none;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-size: 0.9rem;
    padding: 0.4rem 0.8rem;
    transition: width 0.3s ease, opacity 0.3s ease;
  }

  .search-wrapper.open .search-input {
    width: clamp(180px, 25vw, 320px);
    opacity: 1;
    pointer-events: all;
  }

  .search-input::placeholder { color: var(--text-muted); }
  .search-input:focus { outline: none; border-color: var(--accent); }

  /* ── Mega dropdown ── */
  .mega-dropdown {
    position: absolute;
    top: var(--nav-height);
    left: 0; right: 0;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    padding: 1rem 2rem;
    display: none;
    z-index: 800;
  }
  .mega-dropdown.open { display: block; }

  .dropdown-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .dropdown-list a {
    font-size: 0.85rem;
    color: var(--text-muted);
    padding: 0.3rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .dropdown-list a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* ── Search results bar ── */
  .search-results-bar {
    position: fixed;
    top: var(--nav-height);
    left: 0; right: 0;
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    z-index: 850;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0 1.5rem;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
  }
  .search-results-bar.open {
    max-height: 240px;
    padding: 1rem 1.5rem;
  }

  .search-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.5rem;
    width: 260px;
    transition: border-color 0.15s, transform 0.15s;
  }
  .search-card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .search-card-img {
    width: 52px;
    height: 52px;
    border-radius: 5px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .search-card-img img { width: 100%; height: 100%; object-fit: cover; }
  .search-card-cat { font-size: 0.65rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.08em; }
  .search-card-title { font-size: 0.8rem; color: var(--text); font-weight: 600; line-height: 1.3; }
  .no-results { color: var(--text-muted); font-size: 0.9rem; padding: 0.5rem 0; }

  /* ── Mobile hamburger ── */
  .hamburger { display: none; }

  /* ── Mobile drawer ── */
  .mobile-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    z-index: 950;
    backdrop-filter: blur(4px);
  }
  .mobile-overlay.open { display: block; }

  .mobile-drawer {
    position: fixed;
    top: 0; left: 0;
    width: min(320px, 85vw);
    height: 100vh;
    background: var(--bg-card);
    border-right: 1px solid var(--border);
    z-index: 960;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
  }
  .mobile-drawer.open { transform: translateX(0); }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1rem 0.75rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }

  .mobile-search {
    width: 100%;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-size: 0.9rem;
    padding: 0.5rem 0.8rem;
  }
  .mobile-search:focus { outline: none; border-color: var(--accent); }
  .mobile-search::placeholder { color: var(--text-muted); }

  .drawer-item {
    border-bottom: 1px solid var(--border);
  }

  .drawer-cat {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }
  .drawer-cat::-webkit-details-marker { display: none; }
  .drawer-cat::after { content: '+'; color: var(--text-muted); }
  details[open] .drawer-cat::after { content: '−'; }

  .drawer-subs {
    padding: 0 1rem 0.75rem 1.5rem;
  }
  .drawer-subs li a {
    display: block;
    padding: 0.4rem 0;
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color 0.15s;
  }
  .drawer-subs li a:hover { color: var(--accent); }

  /* ── Responsive breakpoints ── */
  @media (max-width: 900px) {
    .desktop-nav { display: none; }
    .hamburger { display: flex; }
  }

  @media (max-width: 500px) {
    .site-header { padding: 0 1rem; gap: 0.75rem; }
    .logo-img { height: 28px; }
  }
</style>
