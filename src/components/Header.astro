<script define:vars={{ menu: menus,}}>
  document.addEventListener('DOMContentLoaded', () => {
  // Grab data
  const menuMap = document.getElementById('menu-data');

  const nav = document.querySelector('.navItem');
  const pop = document.querySelector('.navbarSearchResults');
  const list = document.getElementById('menu-list');
  let activeTrigger = null;

  function openMenu(trigger) {
    const key = trigger.dataset.key || trigger.textContent?.trim() || '';
    const items = menu[key] || [];
    console.log(items, key, menuMap);
    // Build list
    list.innerHTML = items.map((label) => (
      `<li><a href="#" role="menuitem" tabindex="-1">${label}</a></li>`
    )).join('');
    if(pop.style.height == "0px"){
        pop.animate(
        [
          { height: "0px" },
          { height: "200px" }
        ],
        {
            duration: 300,
            easing: "ease-in-out",
          }
        );
        pop.style.height = '200px';
        pop.padding = '12px';
        pop.style.borderBottom = '1px solid white'
        pop.focus();
    // Position under trigger
    // const rect = trigger.getBoundingClientRect();
    // pop.style.left = `${rect.left + rect.width / 2}px`;
    // pop.style.top  = `${rect.bottom + 8 + window.scrollY}px`;

    // Toggle ARIA
    pop.classList.add('visible');
    pop.setAttribute('aria-hidden', 'false');
    trigger.setAttribute('aria-expanded', 'true');
    activeTrigger = trigger;
  }}

  function closeMenu() {
    if (!pop.classList.contains('visible')) return;
    pop.classList.remove('visible');
    pop.setAttribute('aria-hidden', 'true');
    if (activeTrigger) {
      activeTrigger.setAttribute('aria-expanded', 'false');
      activeTrigger = null;
    }
  }

  // Click on a nav link → open/replace menu
  nav.addEventListener('click', (e) => {
    const btn = (e.target).closest('.navLink');
    if (!btn) return;

    // Toggle if same trigger
    if (activeTrigger === btn && pop.classList.contains('visible')) {
      closeMenu();
    } else {
      openMenu(btn);
    }
    console.log(btn);
  });

  // Click outside to close
  document.addEventListener('click', (e) => {
    if (!pop.classList.contains('visible')) return;
    const t = e.target;
    if (!pop.contains(t) && !nav.contains(t)) closeMenu();
  });

  // Escape to close, Arrow nav (optional)
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
    if (!pop.classList.contains('visible')) return;

    const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('a'));
    const idx = links.indexOf(document.activeElement);

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      links[(idx + 1 + links.length) % links.length]?.focus();
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      links[(idx - 1 + links.length) % links.length]?.focus();
    }
  });

  // Reposition on scroll/resize
  window.addEventListener('scroll', () => { if (activeTrigger) openMenu(activeTrigger); }, { passive: true });
  window.addEventListener('resize', () => { if (activeTrigger) openMenu(activeTrigger); });
  })

</script>
