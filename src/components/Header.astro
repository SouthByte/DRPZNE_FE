const menus = {
  TACTICAL: ["Weapons", "HardWare", "Kit", "Appearel", "Accessories"],
  TECHNOLOGY: ["Comms", "Power", "Optics"],
  PROPERTY: ["Storage", "Safes"],
  FITNESS: ["Trucks", "Cars", "Boats", ],
  VEHICLES: ["Racks", "Recovery"],
  MISC: ["EDC", "Accessories"],
  "SUBSTANCE ABUSE": ["Education", "Resources"]
};

type Post = {
  id: number;
  title: string;
  email: string;
  comment: string;
  dateCreated: string;
};
