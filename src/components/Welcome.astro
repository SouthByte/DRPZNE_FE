.card-container {
  display: grid;
  grid-template-columns: repeat(2, 500px);
  gap: 20px;
  justify-content: center;
  padding: 20px;
  width: 100%
} 

.card {
  width:500px; /* Fixed card width */
  height: 500px; /* Fixed card height */
  background-color: lightblue; /* Card background for illustration */
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

/* Media Query for small screens (mobile-first approach) */
@media (max-width: 600px) {
  .card-container {
    grid-template-columns: 1fr; /* Stack cards in a single column on small screens */
  }
}

@media (max-width: 1100px) {
	.card-container{
		grid-template-columns: repeat(2, 450px);
	}
	.card{
		width: 450px;
		height: 450px;
	}
	
}

@media (max-width: 990px) {
	.card-container{
		grid-template-columns: repeat(2, 400px);
	}
	.card{
		width: 400px;
		height: 400px;
	}
}

@media (max-width: 880px) {
	.card-container{
		grid-template-columns: repeat(2, 350px);
	}
	.card{
		width: 350px;
		height: 350px;
	}
}

@media (max-width: 770px) {
	.card-container{
		grid-template-columns: repeat(1);
	}
	.card{
		width: 100%;
	}
}



