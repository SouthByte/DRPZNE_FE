# ============================================
# DRPZNE Frontend Environment Variables
# ============================================
# Copy this to .env and fill in your values

# --- Backend API ---
# Your custom backend API URL (Express, FastAPI, etc.)
# If you're using Sanity as the only backend, you can leave this empty
PUBLIC_API_URL=https://api.drpzne.com

# --- Sanity CMS ---
# Get these from: https://sanity.io/manage
# or by running: npx sanity init (inside /studio folder)
PUBLIC_SANITY_PROJECT_ID=your_project_id_here
PUBLIC_SANITY_DATASET=production

# --- Environment ---
NODE_ENV=development
