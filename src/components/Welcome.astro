/* Common ad styles */
:root {
  --content-width: 1100px;
  --ad-width: 180px;
  --gap: 0px;
}

.fixed-left-ad {
  position: fixed;
  top: 50%;
  left: calc((100vw - var(--content-width)) / 2 - var(--ad-width) - var(--gap));
  transform: translateY(-50%);
  z-index: 9999;
}

.fixed-right-ad {
  position: fixed;
  top: 50%;
  left: calc((98vw + var(--content-width)) / 2 + var(--gap));
  transform: translateY(-50%);
  z-index: 9999;
}

.fixed-left-ad.stop,
.fixed-right-ad.stop {
  position:: fixed;
  top: auto;
  bottom: 120px;
  transform: none;
}

.ad-box {
  width: var(--ad-width);
  height: 300px;
  /* background: rgba(255, 255, 255, 0.08);
  backdrop-filter: blur(10px); */
  border-radius: 16px;
  border: 1px solid white;
  color: white;
}


.layout-wrapper {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 24px;
  padding: 2rem;
} 


	#container {
      min-height: 100vh;
	  position: static;       /* or keep relative but with z-index:auto */
	  z-index: auto;          /* remove the stacking context */
  	  overflow: visible;      /* don’t clip children */
	  background-color: #272729

}  


	main {
		height: 100%;
		display: flex;
		justify-content: center;
	}

	#hero {
		display: flex;
		align-items: start;
		flex-direction: column;
		justify-content: center;
		padding: 16px;
	}

	h1 {
		font-size: 22px;
		margin-top: 0.25em;
	}

	#links {
		display: flex;
		gap: 16px;
	}

	#links a {
		display: flex;
		align-items: center;
		padding: 10px 12px;
		color: #111827;
		text-decoration: none;
		transition: color 0.2s;
	}

	#links a:hover {
		color: rgb(78, 80, 86);
	}

	#links a svg {
		height: 1em;
		margin-left: 8px;
	}

	#links a.button {
		color: white;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		border-radius: 10px;
	}

	#links a.button:hover {
		color: rgb(230, 230, 230);
		box-shadow: none;
	}

	pre {
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		font-weight: normal;
		background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
	}

	h2 {
		margin: 0 0 1em;
		font-weight: normal;
		color: #111827;
		font-size: 20px;
	}

	p {
		color: #4b5563;
		font-size: 16px;
		line-height: 24px;
		letter-spacing: -0.006em;
		margin: 0;
	}

	code {
		display: inline-block;
		background:
			linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
			linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
		border-radius: 8px;
		border: 1px solid transparent;
		padding: 6px 8px;
	}

	.box {
		padding: 16px;
		background: rgba(255, 255, 255, 1);
		border-radius: 16px;
		border: 1px solid white;
		
	}

	#news {
		position: absolute;
		bottom: 35%;
		right: 30px;
		height: 400px;
		text-decoration: none;
		transition: background 0.2s;
		backdrop-filter: blur(50px);
	}

	#news:hover {
		background: rgba(255, 255, 255, 0.55);
	}

	@media (max-width: 1580px){
		#news{
			display: none;
		}
	}

