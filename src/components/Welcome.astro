---
import PostGrid from './PostGrid.astro';
import CategoryPills from './CategoryPills.astro';
import { getPosts } from '../lib/api';

const page = await getPosts({ page: 1 });
---

<section class="catalog-section">
  <CategoryPills />
  <PostGrid page={page} />
</section>

<style>
  .catalog-section {
    background: var(--bg);
    min-height: calc(100vh - var(--nav-height));
    padding: 2rem 1.5rem 4rem;
  }
  @media (max-width: 640px) {
    .catalog-section { padding: 1.5rem 1rem 3rem; }
  }
</style>
